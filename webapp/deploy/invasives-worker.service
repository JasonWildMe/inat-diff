[Unit]
Description=iNaturalist Invasives Monitor Celery Worker
After=network.target redis-server.service

[Service]
Type=simple
User=invasives
Group=invasives
WorkingDirectory=/opt/invasives/inat-diff
EnvironmentFile=/opt/invasives/.env
ExecStart=/opt/invasives/inat-diff/venv/bin/celery -A webapp.tasks worker --loglevel=info --concurrency=2
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=invasives-worker

# Allow long-running tasks (reports can take 2 hours)
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
